# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Resend (Email)
RESEND_API_KEY=

# Other
NEXT_PUBLIC_BASE_URL=http://localhost:3000

SLIPOK_API_KEY=

INGESTION_STATUS_SECRET=

# Stripe (หน้า "ราคาแพ็กเกจ" สำหรับ Super Admin) — ใส่ค่าจริงใน env ของ host เท่านั้น ห้าม commit
# ใช้ Restricted key (rk_...) สิทธิ์: Products Write, Prices Write,
# Customer portal (Billing Portal configurations) Write, Subscriptions Read
STRIPE_SECRET_KEY=
# collection ราคากลาง: live = planPricing · test key ต้องใช้ planPricing_test
PLAN_PRICING_COLLECTION=planPricing
# เปิดปุ่มบันทึกราคา (true) หลังทุกเว็บอ่านราคากลางขึ้น production ครบแล้ว
PRICING_WRITE_ENABLED=false

# ส่งต้นทุนไป Google Sheet (หน้า "ราคาแพ็กเกจ" › ปุ่ม "ส่งไป Google Sheet") — ใส่ค่าจริงใน Vercel เท่านั้น ห้าม commit
# COST_SHEET_ID = ส่วนระหว่าง /d/ กับ /edit ในลิงก์ Sheet (repo นี้ public จึงห้ามใส่ id จริงในโค้ด)
COST_SHEET_ID=your-google-sheet-id
# service account ที่ได้สิทธิ์ "ผู้แก้ไข" ใน Sheet (เว้นว่างทั้งคู่ = ใช้ FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY แทน)
GOOGLE_SHEETS_CLIENT_EMAIL=sheets-sync@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# true = ส่งไป Sheet อัตโนมัติหลังบันทึกสมมติฐาน/ราคา/GP (ส่งไม่สำเร็จไม่ทำให้การบันทึกล้ม แค่เตือน)
COST_SHEET_AUTO_EXPORT=false
